# ==========================================
# RADXA E20C Configuration
# ==========================================
# Device: RADXA E20C (RK3528A)
# Docs: https://docs.radxa.com/e/e20c/getting-started/introduction

# Target System - ARM64 for RK3528A
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y

# Target Profile - RADXA E20C
CONFIG_TARGET_rockchip_armv8_DEVICE_rockchip_rk3528_e20c=y

# Image Configuration
CONFIG_TARGET_rockchip_armv8_DEVICE_rockchip_rk3528_e20c_IMAGES=y

# ==========================================
# Storage Support - eMMC & TF Card
# ==========================================
# Block devices
CONFIG_PACKAGE_kmod-block=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-core=y
CONFIG_PACKAGE_kmod-mmc-rk3xxx=y
CONFIG_PACKAGE_kmod-scsi-mod=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# eMMC support (MMC Block)
CONFIG_PACKAGE_kmod-mmc-block=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_resize2fs=y

# Filesystem tools
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_mkdosfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-utils=y

# TF Card / SD Card
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# ==========================================
# USB Support (1x USB 2.0)
# ==========================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y

# ==========================================
# 4G/5G Module Support
# ==========================================
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-hso=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rtl8153=y
CONFIG_PACKAGE_kmod-usb-net-cdc_mbim=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usb-modeswitch-data=y

# ==========================================
# Android USB Tethering
# ==========================================
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y

# ==========================================
# Cellular Tools
# ==========================================
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-wwan=y

# ==========================================
# LuCI Base
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# Theme
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ==========================================
# Docker Support
# ==========================================
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker-ce=y
CONFIG_PACKAGE_docker-ce-cli=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_kmod-dummy=y

# Docker storage driver options
CONFIG_DOCKER_overlay2=y
CONFIG_DOCKER_bridge=y
CONFIG_DOCKER_host=y
CONFIG_DOCKER_ipvlan_macvlan=y
CONFIG_DOCKER_null_overlay=y

# ==========================================
# OpenClash Support
# ==========================================
CONFIG_PACKAGE_luci-app-openclash=y

# ==========================================
# Other Useful Packages
# ==========================================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_btrfs-progs=y
